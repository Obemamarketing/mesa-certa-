# Copie este arquivo pra .env.local e preencha com os dados do seu projeto
# Supabase (dashboard do projeto > Settings > API).
# NUNCA coloque chaves reais neste arquivo: ele vai pro repositório.

# --- obrigatórias ---------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima-publica

# --- lembretes por WhatsApp (só no servidor / Vercel) ----------------------
# Sem estas variáveis o sistema funciona normalmente: os lembretes ficam
# agendados e simplesmente não são enviados (nada é marcado como "enviado").

# Chave de serviço do Supabase (Settings > API > service_role). Dá acesso total
# ao banco: só no servidor, nunca com o prefixo NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=

# Segredo que protege a rota /api/lembretes/cron (o pg_cron manda no cabeçalho
# Authorization). Use um texto longo e aleatório.
# CRON_SECRET=

# API oficial do WhatsApp (Meta Cloud API)
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=lembrete_reserva
# WHATSAPP_TEMPLATE_LANG=pt_BR
# WHATSAPP_API_VERSION=v21.0

# --- captcha (Cloudflare Turnstile) ---------------------------------------
# Sem estas variáveis o site funciona sem captcha. Passo a passo em
# SEGURANCA.md ("Captcha: como ligar"). A Site Key é pública; a Secret Key e a
# service_role (acima) são secretas e ficam só na Vercel.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
